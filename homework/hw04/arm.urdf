<?xml version="1.0"?>
<!-- Faculty answer for HW04 problem 5. Students receive arm_starter.urdf
     under this file name; keep the links and supplied joints identical. -->
<robot name="hw04_spatial_arm">
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1"/></material>

  <!-- Links: each link frame is where its joint is. Visuals are supplied. -->
  <link name="world"/>
  <link name="arm_base">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <link name="arm_link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.025" length="0.2"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="arm_link2">
    <!-- A cylinder's length runs along its local Z axis; pitch it onto X. -->
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.025" length="0.4"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="arm_link3">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="arm_flange"/>
  <link name="arm_tool">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Supplied: frame 0 placed in the world (problem 4(a)). -->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="arm_base"/>
    <origin xyz="1 0.2 0" rpy="0 0 1.5707963267948966"/>
  </joint>

  <!-- Supplied example: joint 1 rotates about its local Z axis. -->
  <joint name="joint1" type="revolute">
    <parent link="arm_base"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="1"/>
  </joint>

  <!-- HW04 problem 5: the joints below are the assignment. -->
  <joint name="joint2" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="1"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0.4 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="1"/>
  </joint>

  <joint name="flange_joint" type="fixed">
    <parent link="arm_link3"/>
    <child link="arm_flange"/>
    <origin xyz="0.3 0 0"/>
  </joint>

  <joint name="tool_joint" type="fixed">
    <parent link="arm_flange"/>
    <child link="arm_tool"/>
    <origin xyz="0 0 0.1"/>
  </joint>
</robot>
