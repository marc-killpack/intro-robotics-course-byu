<?xml version="1.0"?>
<!-- Faculty answer for HW07 problem 5(a). Students make this file by copying
     their own homework/hw04/arm.urdf to homework/hw07/planar_arm.urdf and
     editing four joints; the links and visuals are unchanged from HW04. -->
<robot name="hw07_planar_arm">
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1"/></material>

  <link name="world"/>
  <link name="arm_base">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <link name="arm_link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.025" length="0.2"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="arm_link2">
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.025" length="0.4"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="arm_link3">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="arm_flange"/>
  <link name="arm_tool">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Edit 1: the planning arm's base is at the world origin. -->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="arm_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Edit 2: the HW04 waist joint becomes a fixed 0.2 m post. -->
  <joint name="post_joint" type="fixed">
    <parent link="arm_base"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Edits 3 and 4: the two moving joints turn about the upright Z axis,
       so the links sweep a horizontal plane 0.2 m above the floor. -->
  <joint name="joint1" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="1" velocity="1"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0.4 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="1" velocity="1"/>
  </joint>

  <joint name="flange_joint" type="fixed">
    <parent link="arm_link3"/>
    <child link="arm_flange"/>
    <origin xyz="0.3 0 0"/>
  </joint>

  <!-- Unchanged from HW04: the tool point sits 0.1 m above the flange. -->
  <joint name="tool_joint" type="fixed">
    <parent link="arm_flange"/>
    <child link="arm_tool"/>
    <origin xyz="0 0 0.1"/>
  </joint>
</robot>
