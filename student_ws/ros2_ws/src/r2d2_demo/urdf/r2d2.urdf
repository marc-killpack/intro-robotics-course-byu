<?xml version="1.0"?>
<!-- An original, simplified R2D2-like teaching model made from basic shapes. -->
<robot name="r2d2_demo">
  <!-- The base frame is on the floor, at the center of the robot. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.53"/>
      <geometry><cylinder radius="0.24" length="0.62"/></geometry>
      <material name="body_white"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
  </link>

  <joint name="head_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.88"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>
  <link name="head">
    <visual>
      <geometry><sphere radius="0.24"/></geometry>
      <material name="head_blue"><color rgba="0.05 0.25 0.8 1"/></material>
    </visual>
  </link>

  <joint name="eye_mount" type="fixed">
    <parent link="head"/>
    <child link="eye"/>
    <origin xyz="0.23 0 0.06"/>
  </joint>
  <link name="eye">
    <visual>
      <geometry><sphere radius="0.065"/></geometry>
      <material name="eye_black"><color rgba="0.02 0.02 0.03 1"/></material>
    </visual>
  </link>

  <joint name="left_leg_tilt" type="revolute">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="0 0.32 0.64"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="1" velocity="1"/>
  </joint>
  <link name="left_leg">
    <visual>
      <origin xyz="0 0 -0.29"/>
      <geometry><box size="0.15 0.15 0.58"/></geometry>
      <material name="left_blue"><color rgba="0.05 0.25 0.8 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.10 0 -0.59"/>
      <geometry><box size="0.34 0.18 0.10"/></geometry>
      <material name="left_foot_blue"><color rgba="0.05 0.25 0.8 1"/></material>
    </visual>
  </link>

  <joint name="right_leg_tilt" type="revolute">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0 -0.32 0.64"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="1" velocity="1"/>
  </joint>
  <link name="right_leg">
    <visual>
      <origin xyz="0 0 -0.29"/>
      <geometry><box size="0.15 0.15 0.58"/></geometry>
      <material name="right_blue"><color rgba="0.05 0.25 0.8 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.10 0 -0.59"/>
      <geometry><box size="0.34 0.18 0.10"/></geometry>
      <material name="right_foot_blue"><color rgba="0.05 0.25 0.8 1"/></material>
    </visual>
  </link>
</robot>
